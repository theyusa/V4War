<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        layout="@layout/layout_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:trackCornerRadius="4dp" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollDnsLeak"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="28dp">

            <!-- Diagnostic Verdict Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardVerdict"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/cardElevatedSurfaceColor"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="?attr/cardStrokeWidth">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/imageVerdictIcon"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_marginEnd="12dp"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/textVerdictTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                tools:text="DNS Queries Protected" />

                            <TextView
                                android:id="@+id/badgeVerdict"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="3dp"
                                android:textSize="12.5sp"
                                android:textStyle="bold"
                                tools:text="SECURE (No Leak)" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textVerdictDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingMultiplier="1.15"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13.5sp"
                        tools:text="All DNS queries are safely routed through your VPN tunnel. Zero ISP leak detected." />

                    <!-- Recommendation Box -->
                    <LinearLayout
                        android:id="@+id/layoutRecommendation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="top"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:id="@+id/iconRecommendation"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginTop="1dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_baseline_info_24"
                            app:tint="?attr/primaryOrTextPrimary" />

                        <TextView
                            android:id="@+id/textRecommendation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:lineSpacingMultiplier="1.15"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="12.5sp"
                            tools:text="Your current connection setup is completely secure against DNS leaks." />
                    </LinearLayout>
                    <!-- Action Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRerunTest"
                        style="@style/Widget.SagerNet.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="48dp"
                        android:paddingVertical="10dp"
                        android:text="@string/start_dns_leak_test"
                        android:textAllCaps="false"
                        android:textSize="13.5sp"
                        app:cornerRadius="16dp"
                        app:icon="@drawable/ic_baseline_refresh_24"
                        app:iconGravity="textStart" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Stage 1: Fake-IP Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFakeIp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="?attr/cardElevatedSurfaceColor"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="?attr/cardStrokeWidth">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/iconFakeIpBadge"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="12dp"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/dns_leak_fakeip_card_title"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="15.5sp" />

                            <TextView
                                android:id="@+id/badgeFakeIp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="3dp"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:visibility="gone"
                                tools:text="Active"
                                tools:visibility="visible" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textFakeIpSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingMultiplier="1.15"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13.5sp"
                        tools:text="Fake-IP mode is active. Domains are intercepted and synthesized locally." />

                    <LinearLayout
                        android:id="@+id/layoutFakeIpSamples"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Stage 2: Client Public Egress Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="?attr/cardElevatedSurfaceColor"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="?attr/cardStrokeWidth">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/iconEgressBadge"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="12dp"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/dns_leak_egress_card_title"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="15.5sp" />

                        <TextView
                            android:id="@+id/badgeWarp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp"
                            android:textSize="12.5sp"
                            android:textStyle="bold"
                            android:visibility="gone"
                            tools:text="WARP"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/boxEgressIp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp">

                        <TextView
                            android:id="@+id/textEgressIp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:fontFeatureSettings="tnum"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textIsSelectable="true"
                            android:textSize="15.5sp"
                            tools:text="185.157.217.124" />

                        <ImageButton
                            android:id="@+id/btnCopyEgressIp"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/network_interfaces_copy_hint"
                            android:src="@drawable/ic_content_copy"
                            app:tint="?attr/primaryOrTextPrimary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textEgressLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingMultiplier="1.15"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13.5sp"
                        tools:text="Location: Turkey (TR)" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Stage 3: DNS Resolver Egress Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardResolver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="?attr/cardElevatedSurfaceColor"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="?attr/cardStrokeWidth">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/iconResolverBadge"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="12dp"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/dns_leak_resolver_card_title"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="15.5sp" />

                            <TextView
                                android:id="@+id/badgeResolverStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="3dp"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:visibility="gone"
                                tools:text="EDNS Probe"
                                tools:visibility="visible" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/boxResolverIp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp">

                        <TextView
                            android:id="@+id/textResolverIp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:fontFeatureSettings="tnum"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textIsSelectable="true"
                            android:textSize="15.5sp"
                            tools:text="104.22.145.72" />

                        <ImageButton
                            android:id="@+id/btnCopyResolverIp"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/network_interfaces_copy_hint"
                            android:src="@drawable/ic_content_copy"
                            app:tint="?attr/primaryOrTextPrimary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textResolverGeo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingMultiplier="1.15"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13.5sp"
                        tools:text="ISP / Geo: Turkey - Cloudflare, Inc." />

                    <TextView
                        android:id="@+id/textResolverNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingMultiplier="1.15"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12.5sp"
                        tools:text="Authoritative recursive resolver observed when querying nonce domain." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Stage 4: System & Private DNS Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSystemDns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="?attr/cardElevatedSurfaceColor"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="?attr/cardStrokeWidth">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/iconSystemDnsBadge"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="12dp"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/dns_leak_system_dns_card_title"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="15.5sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/boxSystemDns"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/textSystemDnsSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:fontFeatureSettings="tnum"
                            android:lineSpacingMultiplier="1.15"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="13.5sp"
                            tools:text="Active DNS: 172.19.0.2 (tun0)" />

                        <TextView
                            android:id="@+id/textPrivateDns"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:lineSpacingMultiplier="1.15"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="13.5sp"
                            tools:text="Private DNS (DoT): Not active" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
