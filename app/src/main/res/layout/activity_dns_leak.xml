<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        layout="@layout/layout_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressIndicator"
        style="@style/Widget.Material3Expressive.LinearProgressIndicator.Wavy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:trackCornerRadius="4dp" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollDnsLeak"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- Minimalist Verdict Hero Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardVerdict"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/cardElevatedSurfaceColor"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="?attr/cardStrokeWidth">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/imageVerdictIcon"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_marginEnd="12dp"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/textVerdictTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="14.5sp"
                                tools:text="DNS Queries Protected" />

                            <TextView
                                android:id="@+id/badgeVerdict"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="sans-serif-medium"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="2dp"
                                android:textSize="11sp"
                                tools:text="SECURE (No Leak)" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRerunTest"
                            style="@style/Widget.Material3Expressive.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="8dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingHorizontal="12dp"
                            android:text="@string/start_dns_leak_test"
                            android:textSize="12sp"
                            app:icon="@drawable/ic_baseline_refresh_24"
                            app:iconPadding="4dp"
                            app:iconSize="16dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textVerdictDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingMultiplier="1.15"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12.5sp"
                        tools:text="All DNS queries are safely routed through your VPN tunnel." />

                    <LinearLayout
                        android:id="@+id/layoutRecommendation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="8dp"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/iconRecommendation"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="8dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_baseline_info_24" />

                        <TextView
                            android:id="@+id/textRecommendation"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:lineSpacingMultiplier="1.1"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="11.5sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Unified Minimalist Breakdown Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="?attr/cardElevatedSurfaceColor"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="?attr/cardStrokeWidth">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <!-- Row 1: Client Public Egress -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/iconEgressBadge"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="10dp"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-medium"
                                    android:text="@string/dns_leak_egress_card_title"
                                    android:textColor="?android:attr/textColorSecondary"
                                    android:textSize="11.5sp" />

                                <TextView
                                    android:id="@+id/badgeWarp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:fontFamily="sans-serif-medium"
                                    android:paddingHorizontal="6dp"
                                    android:paddingVertical="1dp"
                                    android:textSize="10sp"
                                    android:visibility="gone"
                                    tools:text="WARP" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/textEgressIp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif-medium"
                                android:fontFeatureSettings="tnum"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="14sp"
                                tools:text="185.248.141.233" />

                            <TextView
                                android:id="@+id/textEgressLocation"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="11.5sp"
                                tools:text="Frankfurt, Germany" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCopyEgressIp"
                            style="@style/Widget.Material3Expressive.Button.IconButton"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:contentDescription="@string/network_interfaces_copy_hint"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetRight="0dp"
                            android:insetBottom="0dp"
                            android:visibility="gone"
                            app:backgroundTint="@android:color/transparent"
                            app:icon="@drawable/ic_content_copy"
                            app:iconSize="16dp" />
                    </LinearLayout>

                    <View
                        android:id="@+id/dividerLeak1"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="10dp"
                        android:alpha="0.12"
                        android:background="?android:attr/textColorSecondary" />

                    <!-- Row 2: DNS Resolver (Leak Check) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/iconResolverBadge"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="10dp"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:ellipsize="end"
                                    android:fontFamily="sans-serif-medium"
                                    android:maxLines="1"
                                    android:text="@string/dns_leak_resolver_card_title"
                                    android:textColor="?android:attr/textColorSecondary"
                                    android:textSize="11.5sp" />

                                <TextView
                                    android:id="@+id/badgeResolverStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:fontFamily="sans-serif-medium"
                                    android:maxLines="1"
                                    android:paddingHorizontal="6dp"
                                    android:paddingVertical="1dp"
                                    android:textSize="10sp"
                                    android:visibility="gone"
                                    tools:text="EDNS" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/textResolverIp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif-medium"
                                android:fontFeatureSettings="tnum"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="14sp"
                                tools:text="172.71.164.10" />

                            <TextView
                                android:id="@+id/textResolverGeo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="11.5sp"
                                tools:text="Cloudflare" />

                            <TextView
                                android:id="@+id/textResolverNote"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="11sp"
                                android:visibility="gone" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCopyResolverIp"
                            style="@style/Widget.Material3Expressive.Button.IconButton"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:contentDescription="@string/network_interfaces_copy_hint"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetRight="0dp"
                            android:insetBottom="0dp"
                            android:visibility="gone"
                            app:backgroundTint="@android:color/transparent"
                            app:icon="@drawable/ic_content_copy"
                            app:iconSize="16dp" />
                    </LinearLayout>

                    <View
                        android:id="@+id/dividerLeak2"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="10dp"
                        android:alpha="0.12"
                        android:background="?android:attr/textColorSecondary" />

                    <!-- Row 3: Fake-IP & Interception -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/iconFakeIpBadge"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="10dp"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-medium"
                                    android:text="@string/dns_leak_fakeip_card_title"
                                    android:textColor="?android:attr/textColorSecondary"
                                    android:textSize="11.5sp" />

                                <TextView
                                    android:id="@+id/badgeFakeIp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:fontFamily="sans-serif-medium"
                                    android:paddingHorizontal="6dp"
                                    android:paddingVertical="1dp"
                                    android:textSize="10sp"
                                    android:visibility="gone"
                                    tools:text="Inactive" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/textFakeIpSummary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="12.5sp"
                                tools:text="Standard tunneled DNS is resolving domain addresses." />

                            <LinearLayout
                                android:id="@+id/layoutFakeIpSamples"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:orientation="vertical"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="6dp"
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:id="@+id/dividerLeak3"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="10dp"
                        android:alpha="0.12"
                        android:background="?android:attr/textColorSecondary" />

                    <!-- Row 4: System & Private DNS -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/iconSystemDnsBadge"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="10dp"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/dns_leak_system_dns_card_title"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="11.5sp" />

                            <TextView
                                android:id="@+id/textSystemDnsSummary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFeatureSettings="tnum"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="12.5sp"
                                tools:text="Active DNS: 10.0.2.3 (wlan0)" />

                            <TextView
                                android:id="@+id/textPrivateDns"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="11.5sp"
                                android:visibility="gone"
                                tools:text="Private DNS: Off" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
