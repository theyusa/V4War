<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.HomeFragment">

    <include
        layout="@layout/layout_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/home_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingTop="6dp"
        android:paddingBottom="108dp">

        <LinearLayout
            android:id="@+id/home_content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp">

            <!-- Card 1: Running Mode (read-only VPN / System Proxy chips + quick route switch row) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/home_card_running_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/home_icon_running_mode"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_baseline_alt_route_24"
                            app:tint="?android:attr/textColorPrimary" />

                        <TextView
                            android:id="@+id/home_title_running_mode"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:text="@string/home_running_mode"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="14.5sp" />

                        <LinearLayout
                            android:id="@+id/home_chip_mode_vpn"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:clickable="false"
                            android:focusable="false"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="9dp">

                            <TextView
                                android:id="@+id/home_chip_mode_vpn_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="11.5sp"
                                tools:text="• VPN" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/home_chip_mode_proxy"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:layout_marginStart="6dp"
                            android:clickable="false"
                            android:focusable="false"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="9dp">

                            <TextView
                                android:id="@+id/home_chip_mode_proxy_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="11.5sp"
                                tools:text="• System Proxy" />

                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/home_running_route_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:baselineAligned="false"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:orientation="horizontal"
                        android:padding="4dp">

                        <LinearLayout
                            android:id="@+id/home_mode_pill_rule"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1.3"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingHorizontal="8dp">

                            <ImageView
                                android:id="@+id/home_mode_pill_rule_icon"
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_baseline_rule_folder_24"
                                app:tint="?android:attr/textColorPrimary" />

                            <TextView
                                android:id="@+id/home_mode_pill_rule_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif-medium"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:text="@string/home_route_rule"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="12.5sp" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/home_mode_pill_outbound"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingHorizontal="6dp">

                            <ImageView
                                android:id="@+id/home_mode_pill_outbound_icon"
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:contentDescription="@null"
                                android:src="@drawable/baseline_public_24"
                                app:tint="?android:attr/textColorSecondary" />

                            <TextView
                                android:id="@+id/home_mode_pill_outbound_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif-medium"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:text="@string/route_proxy"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="12.5sp" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/home_mode_pill_bypass"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingHorizontal="6dp">

                            <ImageView
                                android:id="@+id/home_mode_pill_bypass_icon"
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_baseline_compare_arrows_24"
                                app:tint="?android:attr/textColorSecondary" />

                            <TextView
                                android:id="@+id/home_mode_pill_bypass_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif-medium"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:text="@string/home_route_bypass"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="12.5sp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Network Speed (LiveChartView sparkline + live TX/RX rate) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/home_card_network_speed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:minHeight="48dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/home_icon_network_speed"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_baseline_speed_24"
                            app:tint="?android:attr/textColorPrimary" />

                        <TextView
                            android:id="@+id/home_title_network_speed"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:text="@string/home_network_speed"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="14.5sp" />

                        <TextView
                            android:id="@+id/home_speed_rate_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFeatureSettings="tnum"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="11.5sp"
                            tools:text="↑ 0 B/s   ↓ 0 B/s" />

                    </LinearLayout>

                    <io.nekohasekai.sagernet.widget.LiveChartView
                        android:id="@+id/home_speed_chart"
                        android:layout_width="match_parent"
                        android:layout_height="112dp"
                        android:layout_marginTop="10dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Row 3: Bento row (Card 3 Traffic Usage on left, right slot reserved for Stage C2) -->
            <LinearLayout
                android:id="@+id/home_bento_row_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/home_card_traffic_usage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:minHeight="48dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/home_icon_traffic_usage"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_baseline_multiline_chart_24"
                                app:tint="?android:attr/textColorPrimary" />

                            <TextView
                                android:id="@+id/home_title_traffic_usage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif-medium"
                                android:maxLines="1"
                                android:text="@string/tools_traffic_usage"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="14.5sp" />

                        </LinearLayout>

                        <io.nekohasekai.sagernet.ui.widget.TrafficRingView
                            android:id="@+id/home_traffic_ring"
                            android:layout_width="92dp"
                            android:layout_height="92dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="12dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/home_traffic_up_icon"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_baseline_upload_24"
                                app:tint="?attr/colorPrimary" />

                            <TextView
                                android:id="@+id/home_traffic_up_value"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:fontFeatureSettings="tnum"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="13sp"
                                tools:text="0" />

                            <TextView
                                android:id="@+id/home_traffic_up_unit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="12sp"
                                tools:text="B" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/home_traffic_down_icon"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_baseline_download_24"
                                app:tint="?attr/colorPrimary" />

                            <TextView
                                android:id="@+id/home_traffic_down_value"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:fontFeatureSettings="tnum"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="13sp"
                                tools:text="0" />

                            <TextView
                                android:id="@+id/home_traffic_down_unit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="12sp"
                                tools:text="B" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:id="@+id/home_bento_right_col"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
