<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        layout="@layout/layout_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_traffic"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="28dp">

            <!-- Live Session Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_live"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/cardElevatedSurfaceColor"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="?attr/cardStrokeWidth">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/icon_traffic"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="12dp"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/traffic_session_title"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="15.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/text_active_profile"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/network_interfaces_vpn_standby"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="12.5sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/badge_session_state"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:textSize="11sp"
                            tools:text="ACTIVE" />
                    </LinearLayout>

                    <!-- Live Proxy & Direct Rates -->
                    <LinearLayout
                        android:id="@+id/box_live_rates"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/traffic_proxy_rate"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="11.5sp" />

                            <TextView
                                android:id="@+id/text_proxy_rate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFeatureSettings="tnum"
                                android:fontFamily="sans-serif-medium"
                                android:text="↓ 0 B/s  ↑ 0 B/s"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/traffic_direct_rate"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="11.5sp" />

                            <TextView
                                android:id="@+id/text_direct_rate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFeatureSettings="tnum"
                                android:fontFamily="sans-serif-medium"
                                android:text="↓ 0 B/s  ↑ 0 B/s"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <io.nekohasekai.sagernet.ui.widget.TrafficBarView
                        android:id="@+id/bar_session"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:id="@+id/text_session_totals"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFeatureSettings="tnum"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12.5sp"
                        tools:text="Session: ↓ 0 B · ↑ 0 B" />

                    <!-- App & Device OS counters -->
                    <LinearLayout
                        android:id="@+id/box_system_counters"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/text_app_traffic"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="12.5sp" />

                        <TextView
                            android:id="@+id/text_device_traffic"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFeatureSettings="tnum"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="12.5sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Stored Profile / Group Summary Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_recorded"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="?attr/cardElevatedSurfaceColor"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="?attr/cardStrokeWidth">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/traffic_recorded_title"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="15.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/text_recorded_totals"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFeatureSettings="tnum"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="12.5sp" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_reset_traffic"
                            style="@style/Widget.SagerNet.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minHeight="40dp"
                            android:paddingHorizontal="12dp"
                            android:text="@string/traffic_reset"
                            android:textSize="12.5sp" />
                    </LinearLayout>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.chip.ChipGroup
                                android:id="@+id/chip_group_scope"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:selectionRequired="true"
                                app:singleLine="true"
                                app:singleSelection="true">

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chip_scope_profiles"
                                    style="@style/Widget.MaterialComponents.Chip.Filter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:checked="true"
                                    android:text="@string/traffic_scope_profiles" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chip_scope_groups"
                                    style="@style/Widget.MaterialComponents.Chip.Filter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/traffic_scope_groups" />
                            </com.google.android.material.chip.ChipGroup>

                            <Space
                                android:layout_width="8dp"
                                android:layout_height="wrap_content" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_hide_zero"
                                style="@style/Widget.MaterialComponents.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:text="@string/traffic_hide_zero" />
                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/container_breakdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
