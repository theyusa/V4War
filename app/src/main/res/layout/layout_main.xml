<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    app:statusBarBackground="@android:color/transparent"
    tools:openDrawer="start">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false">

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/fragment_holder"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.google.android.material.floatingtoolbar.FloatingToolbarLayout
            android:id="@+id/floating_toolbar"
            style="@style/Widget.Material3.FloatingToolbar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_margin="16dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            app:layout_behavior="com.google.android.material.behavior.HideViewOnScrollBehavior">

            <LinearLayout
                android:id="@+id/floating_toolbar_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/toolbar_nav_profiles"
                    style="@style/Widget.Material3.FloatingToolbar.IconButton"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:contentDescription="@string/menu_configuration"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:icon="@drawable/ic_action_description"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="24dp" />

                <FrameLayout
                    android:id="@+id/toolbar_power_container"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <io.nekohasekai.sagernet.widget.ServiceButton
                        android:id="@+id/fab"
                        style="@style/Widget.Material3Expressive.FloatingActionButton"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:elevation="0dp"
                        android:foreground="@drawable/fab_focus_ring"
                        app:backgroundTint="?attr/fabColorBackground"
                        app:borderWidth="0dp"
                        app:elevation="0dp"
                        app:fabCustomSize="56dp"
                        app:hoveredFocusedTranslationZ="0dp"
                        app:maxImageSize="26dp"
                        app:pressedTranslationZ="0dp"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                        app:srcCompat="@drawable/ic_service_idle" />

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/fabProgress"
                        style="@style/Widget.Material3Expressive.CircularProgressIndicator.Wavy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:max="1"
                        android:visibility="invisible"
                        app:indicatorColor="?attr/primaryOrTextSecondary"
                        app:indicatorInset="2dp"
                        app:indicatorSize="62dp"
                        app:trackColor="@android:color/transparent"
                        app:trackCornerRadius="@dimen/mtrl_progress_track_thickness"
                        app:trackThickness="3.5dp" />

                </FrameLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/toolbar_nav_tools"
                    style="@style/Widget.Material3.FloatingToolbar.IconButton"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:contentDescription="@string/menu_tools"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:icon="@drawable/baseline_construction_24"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="24dp" />

            </LinearLayout>

        </com.google.android.material.floatingtoolbar.FloatingToolbarLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        style="@style/Widget.SagerNet.NavigationView"
        app:elevation="0dp"
        android:background="?android:attr/colorBackground"
        app:backgroundTint="?android:attr/colorBackground"
        app:insetForeground="@android:color/transparent"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/layout_drawer_header"
        app:itemBackground="@drawable/bg_nav_item_box"
        app:itemIconSize="36dp"
        app:itemIconPadding="12dp"
        app:itemMinHeight="52dp"
        app:itemTextColor="@color/navigation_icon"
        app:menu="@menu/main_drawer_menu" />

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view_black"
        style="@style/Widget.SagerNet.NavigationView"
        app:elevation="0dp"
        android:background="?android:attr/colorBackground"
        app:backgroundTint="?android:attr/colorBackground"
        app:insetForeground="@android:color/transparent"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/layout_drawer_header"
        app:itemBackground="@drawable/bg_nav_item_box"
        app:itemIconSize="36dp"
        app:itemIconPadding="12dp"
        app:itemMinHeight="52dp"
        app:itemTextColor="@color/navigation_icon"
        app:menu="@menu/main_drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
