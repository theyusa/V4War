<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingTop="6dp"
    android:paddingBottom="64dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="2dp"
        android:paddingBottom="16dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/backup_local_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="6dp"
            app:cardBackgroundColor="?attr/cardElevatedSurfaceColor"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="?attr/cardStrokeWidth">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/backup_local_icon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/backup_local"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/backup_parts_box"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp">

                    <CheckBox
                        android:id="@+id/backup_profiles"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="44dp"
                        android:checked="true"
                        android:paddingStart="6dp"
                        android:text="@string/backup_part_profiles"
                        android:textSize="14.5sp" />

                    <View
                        android:id="@+id/backup_divider_1"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:alpha="0.22"
                        android:background="?attr/colorOutline" />

                    <CheckBox
                        android:id="@+id/backup_routes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="44dp"
                        android:checked="true"
                        android:paddingStart="6dp"
                        android:text="@string/backup_part_routes"
                        android:textSize="14.5sp" />

                    <View
                        android:id="@+id/backup_divider_2"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:alpha="0.22"
                        android:background="?attr/colorOutline" />

                    <CheckBox
                        android:id="@+id/backup_settings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="44dp"
                        android:checked="true"
                        android:paddingStart="6dp"
                        android:text="@string/backup_part_settings"
                        android:textSize="14.5sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/backup_info_box"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingMultiplier="1.15"
                        android:text="@string/backup_local_summary"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12.5sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingMultiplier="1.15"
                        android:text="@string/backup_hotspot_note"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/backup_create"
                    style="@style/Widget.SagerNet.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="48dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="@string/backup_create"
                    android:textAllCaps="false"
                    android:textSize="13.5sp"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_baseline_download_24"
                    app:iconGravity="textStart" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/backup_share"
                        style="@style/Widget.SagerNet.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:maxLines="1"
                        android:minHeight="48dp"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="10dp"
                        android:text="@string/share"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        app:cornerRadius="16dp"
                        app:icon="@drawable/ic_social_share"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp" />

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="wrap_content" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/backup_restore"
                        style="@style/Widget.SagerNet.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:maxLines="1"
                        android:minHeight="48dp"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="10dp"
                        android:text="@string/backup_restore"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        app:cornerRadius="16dp"
                        app:icon="@drawable/ic_baseline_upload_24"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/backup_webdav_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="6dp"
            app:cardBackgroundColor="?attr/cardElevatedSurfaceColor"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="?attr/cardStrokeWidth">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/backup_webdav_icon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/backup_webdav"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="16sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/backup_to_webdav"
                    style="@style/Widget.SagerNet.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="48dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="@string/backup_to_webdav"
                    android:textAllCaps="false"
                    android:textSize="13.5sp"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_baseline_upload_24"
                    app:iconGravity="textStart" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/restore_from_webdav"
                    style="@style/Widget.SagerNet.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:minHeight="48dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp"
                    android:text="@string/restore_from_webdav"
                    android:textAllCaps="false"
                    android:textSize="13.5sp"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_baseline_download_24"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/webdav_settings"
                    style="@style/Widget.SagerNet.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:minHeight="48dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp"
                    android:text="@string/webdav_settings"
                    android:textAllCaps="false"
                    android:textSize="13.5sp"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_action_settings"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
