.github/ISSUE_TEMPLATE/config.yml merge=keep-fork
.github/ISSUE_TEMPLATE/bug-report-en.md merge=keep-fork
.github/ISSUE_TEMPLATE/bug-report-tr.md merge=keep-fork
.github/ISSUE_TEMPLATE/feature_request-en.md merge=keep-fork
